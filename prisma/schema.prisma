// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  REGISTRAR
  TEACHER
  STUDENT
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Gender {
  MALE
  FEMALE
}

enum AddressType {
  CURRENT
  PERMANENT
}

enum ParentType {
  FATHER
  MOTHER
  GUARDIAN
}

enum EnrollmentStatus {
  PENDING
  ENROLLED
  CANCELLED
}

enum DisabilityType {
  VISUAL_IMPAIRMENT_BLIND
  VISUAL_IMPAIRMENT_LOW_VISION
  HEARING_IMPAIRMENT
  LEARNING_DISABILITY
  INTELLECTUAL_DISABILITY
  AUTISM_SPECTRUM_DISORDER
  EMOTIONAL_BEHAVIORAL_DISORDER
  ORTHOPEDIC_PHYSICAL_HANDICAP
  SPEECH_LANGUAGE_DISORDER
  CEREBRAL_PALSY
  SPECIAL_HEALTH_PROBLEM_CHRONIC_DISEASE
  CANCER
  MULTIPLE_DISORDER
}

enum LearningMode {
  MODULAR_PRINT
  MODULAR_DIGITAL
  BLENDED
  FACE_TO_FACE
}

enum Semester {
  FIRST
  SECOND
}

enum Track {
  ACADEMIC
  TVL
  SPORTS
  ARTS_AND_DESIGN
}

enum Strand {
  STEM
  ABM
  HUMSS
  GAS
  TVL_ICT
  TVL_HE
  TVL_AGRI
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum AssessmentType {
  WRITTEN_WORK
  PERFORMANCE_TASK
  QUARTERLY_ASSESSMENT
}

enum AnnouncementAudience {
  ALL
  SECTION
}

model User {
  id                 Int     @id @default(autoincrement())
  username           String  @unique
  password           String
  role               Role
  mustChangePassword Boolean @default(true)
  isActive           Boolean @default(true)

  student Student?
  teacher Teacher?
  admin   Admin?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollmentApplicationReviews EnrollmentApplicationReview[]

  announcements Announcement[]
}

model Teacher {
  id Int @id @default(autoincrement())

  userId Int  @unique
  user   User @relation(fields: [userId], references: [id])

  employeeId String @unique

  assignments TeacherAssignment[]

  firstName     String
  lastName      String
  middleName    String?
  extensionName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attendanceSessoins AttendanceSession[]
}

model Admin {
  id Int @id @default(autoincrement())

  userId Int  @unique
  user   User @relation(fields: [userId], references: [id])

  employeeId String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Student {
  id Int @id @default(autoincrement())

  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  studentNumber String @unique

  firstName     String
  lastName      String
  middleName    String?
  extensionName String?

  enrollmentApplication EnrollmentApplication?
  enrollments           Enrollment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attendances Attendance[]

  studentAssessmentScores StudentAssessmentScore[]

  quarterlyGrades QuarterlyGrade[]

  studentQuarterGrades StudentQuarterGrade[]

  studentFinalGrades StudentFinalGrade[]

  grades Grade[]
}

model EnrollmentApplication {
  id Int @id @default(autoincrement())

  studentId Int?     @unique
  student   Student? @relation(fields: [studentId], references: [id])

  gradeLevel  Int
  hasLRN      Boolean
  isReturning Boolean @default(false)

  schoolYearId Int
  schoolYear   SchoolYear @relation(fields: [schoolYearId], references: [id])

  psaNumber String?
  lrn       String?

  firstName     String
  middleName    String?
  lastName      String
  extensionName String?

  birthDate    DateTime
  gender       Gender
  placeOfBirth String

  isIP        Boolean @default(false)
  ipCommunity String?

  is4Ps       Boolean @default(false)
  householdId String?

  hasDisability Boolean @default(false)

  lastGradeCompleted Int?
  lastSchoolYear     String?
  lastSchoolAttended String?
  lastSchoolId       String?

  semester Semester?
  track    Track?
  strand   Strand?

  status ApplicationStatus @default(PENDING)

  approvedAt DateTime?
  rejectedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  remarks String?

  addresses     EnrollmentApplicationAddress[]
  parents       EnrollmentApplicationParent[]
  disabilities  EnrollmentApplicationDisability[]
  learningModes EnrollmentApplicationLearningMode[]

  enrollmentApplicationReviews EnrollmentApplicationReview[]
}

model SchoolYear {
  id Int @id @default(autoincrement())

  name String @unique

  isCurrent Boolean @default(false)

  startYear Int
  endYear   Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments           Enrollment[]
  curriculums           Curriculum[]
  enrollmentApplication EnrollmentApplication[]
  teachersAssignments   TeacherAssignment[]
  attendanceSessoins    AttendanceSession[]
  gradingPeriods        GradingPeriod[]

  @@unique([startYear, endYear])
  studentQuarterGrades StudentQuarterGrade[]
  studentFinalGrades StudentFinalGrade[]
}

model EnrollmentApplicationAddress {
  id Int @id @default(autoincrement())

  enrollmentApplicationId Int
  enrollmentApplication   EnrollmentApplication @relation(fields: [enrollmentApplicationId], references: [id])

  type AddressType

  houseNo      String?
  street       String?
  sitio        String?
  barangay     String
  municipality String
  province     String
  country      String
  zipCode      String
}

model EnrollmentApplicationParent {
  id Int @id @default(autoincrement())

  enrollmentApplicationId Int
  enrollmentApplication   EnrollmentApplication @relation(fields: [enrollmentApplicationId], references: [id])

  type ParentType

  firstName  String
  middleName String?
  lastName   String

  contactNumber String?
}

model EnrollmentApplicationDisability {
  id Int @id @default(autoincrement())

  enrollmentApplicationId Int
  enrollmentApplication   EnrollmentApplication @relation(fields: [enrollmentApplicationId], references: [id])

  disabilityType DisabilityType
}

model EnrollmentApplicationLearningMode {
  id Int @id @default(autoincrement())

  enrollmentApplicationId Int
  enrollmentApplication   EnrollmentApplication @relation(fields: [enrollmentApplicationId], references: [id])

  learningMode LearningMode
}

model Subject {
  id Int @id @default(autoincrement())

  code String @unique

  name String @unique

  description String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  curriculumSubjects CurriculumSubject[]
  sectionSubjects    SectionSubject[]

  studentQuarterGrades StudentQuarterGrade[]

  studentFinalGrades StudentFinalGrade[]
}

model Curriculum {
  id Int @id @default(autoincrement())

  curriculumName String

  gradeLevel Int

  track Track?

  strand Strand?

  schoolYearId Int

  schoolYear SchoolYear @relation(fields: [schoolYearId], references: [id])

  curriculumSubjects CurriculumSubject[]

  section Section[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([gradeLevel, schoolYearId, track, strand])
}

model CurriculumSubject {
  curriculumId Int

  subjectId Int

  curriculum Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([curriculumId, subjectId])
}

model Section {
  id Int @id @default(autoincrement())

  name String

  capacity Int @default(40)

  isActive Boolean @default(true)

  curriculumId Int

  curriculum Curriculum @relation(fields: [curriculumId], references: [id])

  enrollments Enrollment[]

  sectionSubjects SectionSubject[]

  schedules Schedule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, curriculumId])
  announcements Announcement[]
}

model Enrollment {
  id Int @id @default(autoincrement())

  studentId Int
  student   Student @relation(fields: [studentId], references: [id])

  schoolYearId Int
  schoolYear   SchoolYear @relation(fields: [schoolYearId], references: [id])

  sectionId Int
  section   Section @relation(fields: [sectionId], references: [id])

  status EnrollmentStatus @default(ENROLLED)

  enrolledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, schoolYearId])
}

model Room {
  id Int @id @default(autoincrement())

  name     String
  building String

  isActive Boolean @default(true)

  schedules Schedule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SectionSubject {
  id Int @id @default(autoincrement())

  sectionId Int
  subjectId Int

  section Section @relation(fields: [sectionId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])

  teacherAssignment TeacherAssignment?

  schedules Schedule[]

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  attendanceSessoins AttendanceSession[]
  assessmentItems    AssessmentItem[]
  quarterlyGrades    QuarterlyGrade[]
  assessmentWeights  AssessmentWeight[]

  @@unique([sectionId, subjectId])
  grades Grade[]
}

model TeacherAssignment {
  id Int @id @default(autoincrement())

  teacherId Int
  teacher   Teacher @relation(fields: [teacherId], references: [id])

  sectionSubjectId Int            @unique
  sectionSubject   SectionSubject @relation(fields: [sectionSubjectId], references: [id])

  schoolYearId Int
  schoolYear   SchoolYear @relation(fields: [schoolYearId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sectionSubjectId, schoolYearId])
}

model Schedule {
  id Int @id @default(autoincrement())

  sectionId Int
  section   Section @relation(fields: [sectionId], references: [id])

  roomId Int
  room   Room @relation(fields: [roomId], references: [id])

  sectionSubjectId Int
  sectionSubject   SectionSubject @relation(fields: [sectionSubjectId], references: [id])

  day DayOfWeek

  startTime String
  endTime   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EnrollmentApplicationReview {
  id Int @id @default(autoincrement())

  enrollmentApplicationId Int                   @unique
  enrollmentApplication   EnrollmentApplication @relation(fields: [enrollmentApplicationId], references: [id], onDelete: Cascade)

  reviewId Int
  reviewer User @relation(fields: [reviewId], references: [id])

  remarks String?

  reviewedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model AttendanceSession {
  id Int @id @default(autoincrement())

  sectionSubjectId Int
  sectionSubject   SectionSubject @relation(fields: [sectionSubjectId], references: [id])

  schoolYearId Int
  schoolYear   SchoolYear @relation(fields: [schoolYearId], references: [id])

  attendanceDate DateTime

  createdByTeacherId Int
  createdByTeacher   Teacher @relation(fields: [createdByTeacherId], references: [id])

  attendances Attendance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sectionSubjectId, attendanceDate])
}

model Attendance {
  id Int @id @default(autoincrement())

  attendanceSessionId Int
  attendanceSession   AttendanceSession @relation(fields: [attendanceSessionId], references: [id])

  studentId Int
  student   Student @relation(fields: [studentId], references: [id])

  status AttendanceStatus

  remarks String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([attendanceSessionId, studentId])
}

model GradingPeriod {
  id Int @id @default(autoincrement())

  name    String
  quarter Int

  schoolYearId Int
  schoolYear   SchoolYear @relation(fields: [schoolYearId], references: [id])

  isCurrent Boolean @default(false)
  isOpen    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assessmentItems   AssessmentItem[]
  quarterlyGrades   QuarterlyGrade[]
  assessmentWeights AssessmentWeight[]

  @@unique([schoolYearId, quarter])
  studentQuarterGrades StudentQuarterGrade[]
  grades Grade[]
}

model AssessmentItem {
  id Int @id @default(autoincrement())

  name String

  assessmentType AssessmentType

  highestPossibleScore Decimal @db.Decimal(6, 2)

  gradingPeriodId Int
  gradingPeriod   GradingPeriod @relation(fields: [gradingPeriodId], references: [id])

  sectionSubjectId Int
  sectionSubject   SectionSubject @relation(fields: [sectionSubjectId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentScores StudentAssessmentScore[]

  @@unique([sectionSubjectId, gradingPeriodId, name])
}

model StudentAssessmentScore {
  id Int @id @default(autoincrement())

  assessmentItemId Int
  assessmentItem   AssessmentItem @relation(fields: [assessmentItemId], references: [id])

  studentId Int
  student   Student @relation(fields: [studentId], references: [id])

  score Decimal @db.Decimal(6, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([assessmentItemId, studentId])
}

model QuarterlyGrade {
  id Int @id @default(autoincrement())

  studentId Int
  student   Student @relation(fields: [studentId], references: [id])

  sectionSubjectId Int
  sectionSubject   SectionSubject @relation(fields: [sectionSubjectId], references: [id])

  gradingPeriodId Int
  gradingPeriod   GradingPeriod @relation(fields: [gradingPeriodId], references: [id])

  writtenWorks Decimal @db.Decimal(5, 2)

  performanceTask Decimal @db.Decimal(5, 2)

  quarterlyAssessment Decimal @db.Decimal(5, 2)

  initialGrade Decimal @db.Decimal(5, 2)

  transmutedGrade Decimal @db.Decimal(5, 2)

  isSubmitted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, sectionSubjectId, gradingPeriodId])
}

model AssessmentWeight {
  id Int @id @default(autoincrement())

  sectionSubjectId Int
  sectionSubject   SectionSubject @relation(fields: [sectionSubjectId], references: [id])

  gradingPeriodId Int
  gradingPeriod   GradingPeriod @relation(fields: [gradingPeriodId], references: [id])

  writtenWorkWeight Decimal @db.Decimal(5, 2)

  performanceTaskWeight Decimal @db.Decimal(5, 2)

  quarterlyAssessmentWeight Decimal @db.Decimal(5, 2)

  @@unique([sectionSubjectId, gradingPeriodId])
}

model GradeTransmutation {
  id Int @id @default(autoincrement())

  initialFrom Decimal @db.Decimal(5, 2)
  initialTo Decimal @db.Decimal(5, 2)

  transmutatedGrade Int

  createAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model StudentQuarterGrade {
  id Int @id @default(autoincrement())

  studentId Int
  student Student @relation(fields: [studentId], references: [id])

  subjectId Int
  subject Subject @relation(fields: [subjectId], references: [id])

  schoolYearId Int
  schoolYear SchoolYear @relation(fields: [schoolYearId], references: [id])

  gradingPeriodId Int
  gradingPeriod GradingPeriod @relation(fields: [gradingPeriodId], references: [id])

  quarterGrade Decimal @db.Decimal(5, 2)

  importedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, subjectId, schoolYearId, gradingPeriodId])
}

model StudentFinalGrade {
  id Int @id @default(autoincrement())

  studentId Int
  student Student @relation(fields: [studentId], references: [id])

  subjectId Int
  subject Subject @relation(fields: [subjectId], references: [id])

  schoolYearId Int
  schoolYear SchoolYear @relation(fields: [schoolYearId], references: [id])

  finalGrade Decimal @db.Decimal(5, 2)

  remarks String

  importedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, subjectId, schoolYearId])
}

model Grade {
  id Int @id @default(autoincrement())

  studentId Int
  sectionSubjectId Int
  gradingPeriodId Int
  quarterGrade Decimal @db.Decimal(5, 2)

  student Student @relation(fields: [studentId], references: [id])
  sectionSubject SectionSubject @relation(fields: [sectionSubjectId], references: [id])
  gradingPeriod GradingPeriod @relation(fields: [gradingPeriodId], references: [id])

  @@unique([studentId, sectionSubjectId, gradingPeriodId])
}

model Announcement {
  id Int @id @default(autoincrement())

  title String
  content String
  
  audience AnnouncementAudience @default(ALL)

  sectionId Int?
  section Section? @relation(fields: [sectionId], references: [id])

  createdByUserId Int
  createdByUser User @relation(fields: [createdByUserId], references: [id])

  isPublished Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sectionId])
  @@index([createdByUserId])
}